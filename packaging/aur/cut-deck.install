reload_input() {
  udevadm control --reload 2>/dev/null || true
  udevadm trigger --subsystem-match=input --action=change 2>/dev/null || true
}

post_install() {
  reload_input
  echo ">> CUT can now read touchpads, tablets and gamepads directly."
  echo ">> Start it from your app launcher, or run: cut-deck"
  echo ">> Wacom pad keys are set up automatically; tablet-setup.sh is in /usr/share/cut-deck/"
}

post_upgrade() {
  reload_input
}

post_remove() {
  reload_input
}
