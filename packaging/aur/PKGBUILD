# Maintainer: Galactable
# Kept in github.com/Galactable/cut under packaging/aur; packaging/aur/update.sh bumps it per release.
pkgname=cut-deck
pkgver=0.4.0
pkgrel=1
pkgdesc="Vinyl scratch deck: scratch samples over a backing track with a touchpad, tablet or MIDI DJ controller, and record takes"
arch=('x86_64')
url="https://github.com/Galactable/cut"
license=('CC0-1.0')
depends=('alsa-lib' 'gcc-libs' 'glibc' 'hicolor-icon-theme' 'xorg-xinput' 'zenity')
# jack: only to build (the audio library checks for it); at run time it's optional.
makedepends=('cargo' 'jack')
optdepends=('pipewire-jack: lowest latency through PipeWire'
            'polkit: unlock other devices from the Devices menu'
            'xf86-input-wacom: for tablet-setup.sh')
install=cut-deck.install
# The bundled LAME (MP3) is C; with makepkg's LTO its objects can't be linked by Rust.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('807d4b6f915fc32b8db79ed072ebb9e363cfc90b8f85974d1eaf39ea8b6d8a4c')

prepare() {
  cd "cut-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "cut-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "cut-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "cut-$pkgver"
  install -Dm755 target/release/cut-deck "$pkgdir/usr/bin/cut-deck"

  for s in 16 24 32 48 64 128 256; do
    target/release/cut-deck --write-icon "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/cut-deck.png" "$s"
  done

  # No MimeType line: CUT shouldn't take over as the default audio player.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/cut-deck.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=CUT
GenericName=Vinyl scratch deck
Comment=Dig a sample, scratch it with your fingers, record takes for your DAW
Keywords=scratch;vinyl;turntable;dj;sample;turntablism;
Exec=cut-deck %f
Icon=cut-deck
Terminal=false
Categories=AudioVideo;Audio;Music;
StartupWMClass=cut-deck
EOF

  # Read access to touchpads, tablets, tablet pads and gamepads for the person at the
  # computer (the same rule input-access.sh writes). Keyboards and mice stay root-only.
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/udev/rules.d/70-cut-deck.rules" <<EOF
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TOUCHPAD}=="1", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TABLET}=="1", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TABLET_PAD}=="1", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_JOYSTICK}=="1", TAG+="uaccess"
EOF

  install -Dm755 tablet-setup.sh "$pkgdir/usr/share/cut-deck/tablet-setup.sh"
  install -Dm644 README.md CHANGELOG.md -t "$pkgdir/usr/share/doc/cut-deck/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/cut-deck/LICENSE"
}
